# Salin menjadi .env lalu isi nilainya. Jangan commit .env.
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
# HTTPS (aktifkan setelah TLS di reverse proxy siap)
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false

# Database: mysql (MySQL/MariaDB) atau sqlite
DB_ENGINE=mysql
DB_NAME=eoffice
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# DB Redis khusus E-Office; jangan berbagi DB/antrean dengan aplikasi lain.
CELERY_BROKER_URL=redis://localhost:6379/5
CELERY_QUEUE=eoffice
TIME_ZONE=Asia/Jakarta
LOG_LEVEL=INFO

# Aturan bisnis yang dapat dikonfigurasi (PRD Bab 16)
EOFFICE_INSTRUCTION_ISSUER_ROLES=DIREKTUR,WADIR,SEKRETARIS
EOFFICE_REMINDER_DAYS_BEFORE=2
EOFFICE_ESCALATION_DAYS_OVERDUE=3
EOFFICE_REMINDER_HOUR=7

# Unggahan
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,xls,xlsx

# Pengingat agenda (hari sebelum kegiatan; 0 = hari-H) dan retensi arsip (tahun, per jenis)
EOFFICE_AGENDA_REMINDER_DAYS=1,0
EOFFICE_RETENTION_YEARS=DEFAULT=5

# Mode awal instalasi baru: DEMO = data contoh dimuat otomatis sekali saat container start; PRODUKSI = kosong.
# Setelah terpasang, mode diatur di menu Pengaturan Aplikasi (tersimpan di database, tidak berubah saat update).
EOFFICE_MODE_AWAL=DEMO
# Kata sandi semua akun demo_* (salah satunya Administrator). WAJIB diganti di server.
EOFFICE_DEMO_PASSWORD=ganti-sandi-demo
