# Salin menjadi .env.production (folder induk) lalu isi. JANGAN commit .env.production.
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang-minimal-50-karakter
# Domain dari Nginx Proxy Manager + akses langsung lewat port 8090 (IP server) untuk uji awal.
DJANGO_ALLOWED_HOSTS=eoffice.domain-rs.id,localhost,127.0.0.1,IP_SERVER
DJANGO_CSRF_TRUSTED_ORIGINS=https://eoffice.domain-rs.id,http://IP_SERVER:8090
# HTTPS dipegang Nginx Proxy Manager. Set true setelah domain HTTPS jalan (cookie hanya via HTTPS).
# Catatan: dengan SSL_REDIRECT=true akses langsung http://IP_SERVER:8090 ikut dialihkan ke https.
# Bisa juga tetap false dan aktifkan "Force SSL" di Nginx Proxy Manager.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false

# Database = container eoffice_db (samakan dengan .env.db)
DB_ENGINE=mysql
DB_NAME=eoffice
DB_USER=eoffice
DB_PASSWORD=samakan-dengan-MARIADB_PASSWORD
DB_HOST=db
DB_PORT=3306

# Redis milik E-Office sendiri (container eoffice_redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_QUEUE=eoffice

# RSI Yatofa berada di zona WITA: pengingat harian jam 07.00 waktu setempat.
TIME_ZONE=Asia/Makassar
LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# Aturan bisnis (PRD Bab 16)
EOFFICE_INSTRUCTION_ISSUER_ROLES=DIREKTUR,WADIR,SEKRETARIS
EOFFICE_REMINDER_DAYS_BEFORE=2
EOFFICE_ESCALATION_DAYS_OVERDUE=3
EOFFICE_REMINDER_HOUR=7
EOFFICE_AGENDA_REMINDER_DAYS=1,0
EOFFICE_RETENTION_YEARS=DEFAULT=5
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,xls,xlsx

# Mode awal instalasi baru: DEMO = data contoh dimuat sekali saat start; PRODUKSI = kosong.
# Setelah terpasang, mode diatur di menu Pengaturan Aplikasi (tersimpan di database).
EOFFICE_MODE_AWAL=DEMO
# Kata sandi semua akun demo_* (salah satunya Administrator). Kosong = data demo TIDAK dimuat.
EOFFICE_DEMO_PASSWORD=ganti-sandi-demo-yang-kuat
